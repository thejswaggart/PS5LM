+// PS5LM: every tool result the model reads ends with how full its context is,
+// whichever tool wrote it: llama-server's own tools add the line themselves
+// (server-tools.cpp), and here it goes on the rest, such as the MCP servers the
+// browser runs. The browser keeps the conversation without the line, so each
+// line added is remembered by the tool call's id and the result's text and put
+// back on the same result in every later request: a prompt that changed would
+// be processed again from that point, slowly on the console.
+std::string ps5lm_context_note();  // server-tools.cpp: the count, and past LLAMA_HANDOFF_AT the warning
+
+static std::string ps5lm_content_text(const json & content) {
+    if (content.is_string()) {
+        return content.get<std::string>();
+    }
+    std::string text;
+    if (content.is_array()) {
+        for (const json & part : content) {
+            if (part.is_object() && part.value("type", std::string()) == "text") {
+                text += part.value("text", std::string());
+            }
+        }
+    }
+    return text;
+}
+
+static void ps5lm_note_tool_results(json & body) {
+    static std::mutex mutex;
+    static std::unordered_map<std::string, std::string> notes;
+    if (!body.contains("messages") || !body.at("messages").is_array()) {
+        return;
+    }
+    json & messages = body.at("messages");
+    // the results at the end, after the model's last call, are new in this request
+    size_t first_new = messages.size();
+    while (first_new > 0 && messages[first_new - 1].is_object()
+            && messages[first_new - 1].value("role", std::string()) == "tool") {
+        first_new--;
+    }
+    std::unordered_map<std::string, std::string> call_names;  // tool call id -> tool name
+    std::string fresh;
+    bool fresh_made = false;
+    std::lock_guard<std::mutex> lock(mutex);
+    for (size_t i = 0; i < messages.size(); i++) {
+        json & message = messages[i];
+        if (!message.is_object()) {
+            continue;
+        }
+        const std::string role = message.value("role", std::string());
+        if (role == "assistant" && message.contains("tool_calls") && message.at("tool_calls").is_array()) {
+            for (const json & call : message.at("tool_calls")) {
+                if (call.is_object() && call.contains("function") && call.at("function").is_object()) {
+                    call_names[call.value("id", std::string())] = call.at("function").value("name", std::string());
+                }
+            }
+        }
+        if (role != "tool" || !message.contains("content")) {
+            continue;
+        }
+        json & content = message.at("content");
+        if (!content.is_string() && !content.is_array()) {
+            continue;
+        }
+        const std::string id = message.value("tool_call_id", std::string());
+        const std::string name = call_names.count(id) ? call_names[id] : std::string();
+        const std::string text = ps5lm_content_text(content);
+        // the handoff tools say it themselves, and llama-server's tools may have
+        if (name == "context_status" || name == "save_handoff" || name == "load_handoff"
+                || text.find("[context: ") != std::string::npos) {
+            continue;
+        }
+        const std::string key = id + '\x1f' + std::to_string(std::hash<std::string>{}(text));
+        std::string note;
+        if (auto it = notes.find(key); it != notes.end()) {
+            note = it->second;
+        } else if (i >= first_new) {
+            if (!fresh_made) {
+                fresh = ps5lm_context_note();
+                fresh_made = true;
+            }
+            if (fresh.empty()) {
+                continue;
+            }
+            if (notes.size() >= 4096) {
+                notes.clear();  // old conversations: at worst processed once more
+            }
+            note = fresh;
+            notes.emplace(key, note);
+        } else {
+            continue;
+        }
+        if (content.is_string()) {
+            content = content.get<std::string>() + note;
+        } else {
+            content.push_back({{"type", "text"}, {"text", note}});
+        }
+    }
+}
