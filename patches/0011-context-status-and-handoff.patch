 // public API
 //
 
+//
+// PS5LM: the tokens the last request left in the context and the context's size,
+// set in server-context.cpp; -1 until a request has run
+//
+
+std::atomic<int> ps5lm_ctx_used{-1};
+std::atomic<int> ps5lm_ctx_size{0};
+
+//
+// PS5LM: the model's own context, and a handoff note for the next conversation.
+// llama-server counts the tokens of the last request (prompt and answer) when
+// its slot is released, below in server-context.cpp. context_status and each
+// remote_command result tell the model; past LLAMA_HANDOFF_AT percent (default
+// 70) they also ask it to write a handoff note with save_handoff, which goes to
+// LLAMA_HANDOFF_PATH on the machine llama-server runs on, never through the
+// file tools, so the model needs no path. load_handoff reads it back in a new
+// conversation.
+//
+
+static int ps5lm_handoff_at() {
+    const char * at = std::getenv("LLAMA_HANDOFF_AT");
+    const int pct = at && *at ? std::atoi(at) : 70;
+    return pct > 0 && pct <= 100 ? pct : 70;
+}
+
+static std::string ps5lm_context_line() {
+    const int used = ps5lm_ctx_used.load();
+    const int size = ps5lm_ctx_size.load();
+    if (used < 0 || size <= 0) {
+        return "";
+    }
+    const int pct = (int) ((int64_t) used * 100 / size);
+    std::string line = string_format("\n[context: %d of %d tokens used (%d%%), before this result]\n", used, size, pct);
+    if (pct >= ps5lm_handoff_at()) {
+        line += "[context nearly full: finish the step you are on, then call save_handoff with a summary "
+                "of the work so far and what is left, and tell the user to start a new conversation]\n";
+    }
+    return line;
+}
+
+static std::string ps5lm_handoff_path() {
+    const char * path = std::getenv("LLAMA_HANDOFF_PATH");
+    return path && *path ? path : "handoff.md";
+}
+
+static constexpr size_t SERVER_TOOL_HANDOFF_MAX_SIZE = 64 * 1024;
+
+struct server_tool_context_status : server_tool {
+    server_tool_context_status() {
+        name = "context_status";
+        display_name = "Context status";
+        permission_write = false;
+    }
+
+    json get_definition() const override {
+        return {
+            {"type", "function"},
+            {"function", {
+                {"name", name},
+                {"description", "How much of your context window this conversation has used, in tokens. "
+                                "When it is nearly full, save a handoff note with save_handoff."},
+                {"parameters", {
+                    {"type", "object"},
+                    {"properties", json::object()},
+                }},
+            }},
+        };
+    }
+
+    json invoke(json, server_tool::stream *) const override {
+        const std::string line = ps5lm_context_line();
+        if (line.empty()) {
+            return {{"plain_text_response", "context: not counted yet"}};
+        }
+        return {{"plain_text_response", line.substr(1) + string_format(
+            "[save_handoff is due at %d%%]\n", ps5lm_handoff_at())}};
+    }
+};
+
+struct server_tool_save_handoff : server_tool {
+    server_tool_save_handoff() {
+        name = "save_handoff";
+        display_name = "Save handoff note";
+        permission_write = false;  // one fixed file, nothing the model can aim elsewhere
+    }
+
+    json get_definition() const override {
+        return {
+            {"type", "function"},
+            {"function", {
+                {"name", name},
+                {"description", "Save a handoff note for the next conversation, replacing the last one. "
+                                "Use it when your context is nearly full or the user asks. Write it for a reader "
+                                "who knows nothing of this conversation: the goal, what is done, what was found "
+                                "(commands, file paths and on which machine, results), what is left, and the next step. "
+                                "It is kept by this server; there is no path to give."},
+                {"parameters", {
+                    {"type", "object"},
+                    {"properties", {
+                        {"content", {{"type", "string"}, {"description", "The note, in Markdown"}}},
+                    }},
+                    {"required", json::array({"content"})},
+                }},
+            }},
+        };
+    }
+
+    json invoke(json params, server_tool::stream *) const override {
+        const std::string content = params.at("content").get<std::string>();
+        if (content.size() > SERVER_TOOL_HANDOFF_MAX_SIZE) {
+            return {{"error", string_format("note too long (%zu bytes, max %zu): shorten it",
+                                            content.size(), SERVER_TOOL_HANDOFF_MAX_SIZE)}};
+        }
+        const std::string path = ps5lm_handoff_path();
+        std::error_code ec;
+        const auto parent = fs::path(path).parent_path();
+        if (!parent.empty()) {
+            fs::create_directories(parent, ec);
+        }
+        // write beside it, then rename: a crash never leaves half a note
+        const std::string tmp = path + ".tmp";
+        {
+            std::ofstream out(tmp, std::ios::binary | std::ios::trunc);
+            out.write(content.data(), (std::streamsize) content.size());
+            if (!out) {
+                return {{"error", "cannot write the handoff note"}};
+            }
+        }
+        fs::rename(tmp, path, ec);
+        if (ec) {
+            return {{"error", "cannot save the handoff note: " + ec.message()}};
+        }
+        return {{"plain_text_response", string_format(
+            "handoff note saved (%zu bytes). Tell the user to start a new conversation and ask it to load the handoff.",
+            content.size())}};
+    }
+};
+
+struct server_tool_load_handoff : server_tool {
+    server_tool_load_handoff() {
+        name = "load_handoff";
+        display_name = "Load handoff note";
+        permission_write = false;
+    }
+
+    json get_definition() const override {
+        return {
+            {"type", "function"},
+            {"function", {
+                {"name", name},
+                {"description", "Read the handoff note an earlier conversation saved with save_handoff, "
+                                "to carry on its work. Use it when the user asks to continue or to load the handoff."},
+                {"parameters", {
+                    {"type", "object"},
+                    {"properties", json::object()},
+                }},
+            }},
+        };
+    }
+
+    json invoke(json, server_tool::stream *) const override {
+        std::ifstream in(ps5lm_handoff_path(), std::ios::binary);
+        if (!in) {
+            return {{"plain_text_response", "no handoff note has been saved"}};
+        }
+        std::string content((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+        if (content.size() > SERVER_TOOL_HANDOFF_MAX_SIZE) {
+            content.resize(SERVER_TOOL_HANDOFF_MAX_SIZE);
+            content += "\n[cut]";
+        }
+        return {{"plain_text_response", content}};
+    }
+};
+
