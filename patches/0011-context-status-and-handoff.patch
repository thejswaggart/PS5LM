+//
+// PS5LM: the tokens the last request left in the context and the context's size,
+// set in server-context.cpp; -1 until a request has run
+//
+
+std::atomic<int> ps5lm_ctx_used{-1};
+std::atomic<int> ps5lm_ctx_size{0};
+
+//
+// PS5LM: the model's own context, and a handoff note for the next conversation.
+// llama-server counts the tokens of the last request (prompt and answer) when
+// its slot is released, below in server-context.cpp. context_status and each
+// remote_command result tell the model; past LLAMA_HANDOFF_AT percent (default
+// 70) they also ask it to write a handoff note with save_handoff, kept by name
+// on the machine llama-server runs on, never through the file tools, so the
+// model needs no path. load_handoff reads one back in a new conversation, and
+// GET /tools?list=handoffs lists them for the web UI, without the model, and
+// GET /tools?handoff=<name> shows one as a page.
+//
+
+static int ps5lm_handoff_at() {
+    const char * at = std::getenv("LLAMA_HANDOFF_AT");
+    const int pct = at && *at ? std::atoi(at) : 70;
+    return pct > 0 && pct <= 100 ? pct : 70;
+}
+
+static std::string ps5lm_context_line() {
+    const int used = ps5lm_ctx_used.load();
+    const int size = ps5lm_ctx_size.load();
+    if (used < 0 || size <= 0) {
+        return "";
+    }
+    const int pct = (int) ((int64_t) used * 100 / size);
+    std::string line = string_format("\n[context: %d of %d tokens used (%d%%), before this result]\n", used, size, pct);
+    if (pct >= ps5lm_handoff_at()) {
+        line += "[WARNING: CONTEXT NEARLY FULL! FINISH THE STEP YOU ARE ON, THEN CALL save_handoff WITH A SUMMARY "
+                "OF THE WORK SO FAR AND WHAT IS LEFT, AND TELL THE USER TO START A NEW CONVERSATION!!]\n";
+    }
+    return line;
+}
+
+// what a tool's result ends with: the count for remote_command, and for the
+// others the count and warning only once save_handoff is due. Nothing for the
+// handoff tools, which say it themselves.
+static std::string ps5lm_tool_note(const std::string & tool_name) {
+    if (tool_name == "remote_command") {
+        return ps5lm_context_line();
+    }
+    if (tool_name == "context_status" || tool_name == "save_handoff" || tool_name == "load_handoff") {
+        return "";
+    }
+    const std::string line = ps5lm_context_line();
+    return line.find("[WARNING") != std::string::npos ? line : "";
+}
+
+// Handoff notes are kept by name, one file each, in LLAMA_HANDOFF_DIR (by default
+// a "handoffs" folder beside LLAMA_HANDOFF_PATH, where the single note of
+// earlier builds was kept; that note is moved in as "handoff").
+static fs::path ps5lm_handoff_dir() {
+    const char * dir = std::getenv("LLAMA_HANDOFF_DIR");
+    if (dir && *dir) {
+        return dir;
+    }
+    const char * old = std::getenv("LLAMA_HANDOFF_PATH");
+    const fs::path parent = old && *old ? fs::path(old).parent_path() : fs::path();
+    return parent / "handoffs";
+}
+
+// the dir, made if need be, with the old single note moved in
+static fs::path ps5lm_handoff_dir_ready() {
+    const fs::path dir = ps5lm_handoff_dir();
+    std::error_code ec;
+    fs::create_directories(dir, ec);
+    const char * old = std::getenv("LLAMA_HANDOFF_PATH");
+    if (old && *old && fs::is_regular_file(old, ec) && !fs::exists(dir / "handoff.md", ec)) {
+        fs::rename(old, dir / "handoff.md", ec);
+    }
+    return dir;
+}
+
+// "FTP deploy fix!" -> "ftp-deploy-fix"; "" when nothing usable is left
+static std::string ps5lm_handoff_name(const std::string & raw) {
+    std::string name;
+    for (unsigned char c : raw) {
+        if (std::isalnum(c) || c == '_') {
+            name += (char) std::tolower(c);
+        } else if (!name.empty() && name.back() != '-') {
+            name += '-';
+        }
+        if (name.size() >= 64) {
+            break;
+        }
+    }
+    while (!name.empty() && name.back() == '-') {
+        name.pop_back();
+    }
+    return name;
+}
+
+struct ps5lm_handoff_entry {
+    std::string name;
+    uintmax_t   bytes;
+    int64_t     modified;  // unix seconds
+};
+
+// newest first
+static std::vector<ps5lm_handoff_entry> ps5lm_handoff_list() {
+    std::vector<ps5lm_handoff_entry> out;
+    std::error_code ec;
+    const auto now_file = fs::file_time_type::clock::now();
+    const auto now_sys  = std::chrono::system_clock::now();
+    for (fs::directory_iterator it(ps5lm_handoff_dir_ready(), ec), end; !ec && it != end; it.increment(ec)) {
+        const fs::path p = it->path();
+        if (p.extension() != ".md" || !it->is_regular_file(ec)) {
+            continue;
+        }
+        const auto age = now_file - fs::last_write_time(p, ec);
+        const auto when = now_sys - std::chrono::duration_cast<std::chrono::system_clock::duration>(age);
+        out.push_back({p.stem().string(), fs::file_size(p, ec),
+                       (int64_t) std::chrono::duration_cast<std::chrono::seconds>(when.time_since_epoch()).count()});
+    }
+    std::sort(out.begin(), out.end(), [](const auto & a, const auto & b) { return a.modified > b.modified; });
+    return out;
+}
+
+static std::string ps5lm_handoff_names() {
+    std::string names;
+    for (const auto & e : ps5lm_handoff_list()) {
+        names += (names.empty() ? "" : ", ") + e.name;
+    }
+    return names.empty() ? "(none)" : names;
+}
+
+static constexpr size_t SERVER_TOOL_HANDOFF_MAX_SIZE = 64 * 1024;
+
+// One note as a page to read in the browser (GET /tools?handoff=<name>), the
+// Markdown as it was written, escaped, in a <pre> that wraps.
+static bool ps5lm_handoff_page(const std::string & raw_name, std::string & page) {
+    const std::string note_name = ps5lm_handoff_name(raw_name);
+    if (note_name.empty()) {
+        return false;
+    }
+    std::ifstream in(ps5lm_handoff_dir_ready() / (note_name + ".md"), std::ios::binary);
+    if (!in) {
+        return false;
+    }
+    const std::string content((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    std::string text;
+    for (char c : content) {
+        switch (c) {
+            case '&': text += "&amp;"; break;
+            case '<': text += "&lt;";  break;
+            case '>': text += "&gt;";  break;
+            default:  text += c;
+        }
+    }
+    page = "<!doctype html><html><head><meta charset=\"utf-8\">"
+           "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
+           "<title>" + note_name + " - handoff</title><style>"
+           ":root{color-scheme:light dark}body{margin:0 auto;max-width:860px;padding:24px 16px;"
+           "font:15px/1.55 system-ui,sans-serif}h1{font-size:18px;margin:0 0 16px}"
+           "pre{white-space:pre-wrap;word-wrap:break-word;font:14px/1.55 ui-monospace,monospace}"
+           "</style></head><body><h1>" + note_name + "</h1><pre>" + text + "</pre></body></html>";
+    return true;
+}
+
+struct server_tool_context_status : server_tool {
+    server_tool_context_status() {
+        name = "context_status";
+        display_name = "Context status";
+        permission_write = false;
+    }
+
+    json get_definition() const override {
+        return {
+            {"type", "function"},
+            {"function", {
+                {"name", name},
+                {"description", "How much of your context window this conversation has used, in tokens. "
+                                "When it is nearly full, save a handoff note with save_handoff."},
+                {"parameters", {
+                    {"type", "object"},
+                    {"properties", json::object()},
+                }},
+            }},
+        };
+    }
+
+    json invoke(json, server_tool::stream *) const override {
+        const std::string line = ps5lm_context_line();
+        if (line.empty()) {
+            return {{"plain_text_response", "context: not counted yet"}};
+        }
+        return {{"plain_text_response", line.substr(1) + string_format(
+            "[save_handoff is due at %d%%]\n", ps5lm_handoff_at())}};
+    }
+};
+
+struct server_tool_save_handoff : server_tool {
+    server_tool_save_handoff() {
+        name = "save_handoff";
+        display_name = "Save handoff note";
+        permission_write = false;  // one folder of its own, nothing the model can aim elsewhere
+    }
+
+    json get_definition() const override {
+        return {
+            {"type", "function"},
+            {"function", {
+                {"name", name},
+                {"description", "Save a handoff note for a later conversation, under a short name for the work. "
+                                "Use it when your context is nearly full or the user asks. Write it for a reader "
+                                "who knows nothing of this conversation: the goal, what is done, what was found "
+                                "(commands, file paths and on which machine, results), what is left, and the next step. "
+                                "It is kept by this server; there is no path to give."},
+                {"parameters", {
+                    {"type", "object"},
+                    {"properties", {
+                        {"name", {{"type", "string"}, {"description",
+                            "A short name for the work, a few words, e.g. \"ftp deploy fix\". "
+                            "Use the same name to replace a note saved earlier for the same work"}}},
+                        {"content", {{"type", "string"}, {"description", "The note, in Markdown"}}},
+                    }},
+                    {"required", json::array({"name", "content"})},
+                }},
+            }},
+        };
+    }
+
+    json invoke(json params, server_tool::stream *) const override {
+        const std::string note_name = ps5lm_handoff_name(params.value("name", std::string()));
+        if (note_name.empty()) {
+            return {{"error", "give the note a name: a few words for the work, e.g. \"ftp deploy fix\""}};
+        }
+        const std::string content = params.at("content").get<std::string>();
+        if (content.size() > SERVER_TOOL_HANDOFF_MAX_SIZE) {
+            return {{"error", string_format("note too long (%zu bytes, max %zu): shorten it",
+                                            content.size(), SERVER_TOOL_HANDOFF_MAX_SIZE)}};
+        }
+        const fs::path path = ps5lm_handoff_dir_ready() / (note_name + ".md");
+        std::error_code ec;
+        const bool replaced = fs::exists(path, ec);
+        // write beside it, then rename: a crash never leaves half a note
+        const fs::path tmp = path.string() + ".tmp";
+        {
+            std::ofstream out(tmp, std::ios::binary | std::ios::trunc);
+            out.write(content.data(), (std::streamsize) content.size());
+            if (!out) {
+                return {{"error", "cannot write the handoff note"}};
+            }
+        }
+        fs::rename(tmp, path, ec);
+        if (ec) {
+            return {{"error", "cannot save the handoff note: " + ec.message()}};
+        }
+        return {{"plain_text_response", string_format(
+            "handoff note \"%s\" %s (%zu bytes). Tell the user to start a new conversation and ask it to "
+            "load the handoff \"%s\".", note_name.c_str(), replaced ? "replaced" : "saved", content.size(),
+            note_name.c_str())}};
+    }
+};
+
+struct server_tool_load_handoff : server_tool {
+    server_tool_load_handoff() {
+        name = "load_handoff";
+        display_name = "Load handoff note";
+        permission_write = false;
+    }
+
+    json get_definition() const override {
+        return {
+            {"type", "function"},
+            {"function", {
+                {"name", name},
+                {"description", "Read a handoff note an earlier conversation saved with save_handoff, "
+                                "to carry on its work. Use it when the user asks to continue or to load a handoff."},
+                {"parameters", {
+                    {"type", "object"},
+                    {"properties", {
+                        {"name", {{"type", "string"}, {"description",
+                            "The note's name, as the user gives it. Leave it out for the most recent note"}}},
+                    }},
+                }},
+            }},
+        };
+    }
+
+    json invoke(json params, server_tool::stream *) const override {
+        std::string note_name = ps5lm_handoff_name(params.value("name", std::string()));
+        if (note_name.empty()) {
+            const auto all = ps5lm_handoff_list();
+            if (all.empty()) {
+                return {{"plain_text_response", "no handoff note has been saved"}};
+            }
+            note_name = all.front().name;
+        }
+        std::ifstream in(ps5lm_handoff_dir_ready() / (note_name + ".md"), std::ios::binary);
+        if (!in) {
+            return {{"plain_text_response", "no handoff note \"" + note_name + "\". Saved notes: " +
+                                            ps5lm_handoff_names()}};
+        }
+        std::string content((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+        if (content.size() > SERVER_TOOL_HANDOFF_MAX_SIZE) {
+            content.resize(SERVER_TOOL_HANDOFF_MAX_SIZE);
+            content += "\n[cut]";
+        }
+        return {{"plain_text_response", "[handoff note \"" + note_name + "\"]\n" + content}};
+    }
+};
