+// PS5LM: what ps5lm_chat_params_parse in server-context.cpp adds to a chat request
+std::string ps5lm_context_warning(int n_tokens, bool saved) {
+    const int size = ps5lm_ctx_size.load();
+    if (size <= 0) {
+        return "";
+    }
+    const int pct = (int) ((int64_t) n_tokens * 100 / size);
+    if (pct < ps5lm_handoff_at()) {
+        return "";
+    }
+    if (saved) {
+        return string_format("\n\n[WARNING: CONTEXT NEARLY FULL! %d OF %d TOKENS USED (%d%%). THE HANDOFF NOTE IS SAVED. "
+                             "STOP WORKING AND TELL THE USER TO START A NEW CONVERSATION!!]\n", n_tokens, size, pct);
+    }
+    return string_format("\n\n[WARNING: CONTEXT NEARLY FULL! %d OF %d TOKENS USED (%d%%). FINISH THE STEP YOU ARE ON, THEN CALL "
+                         "save_handoff WITH A SUMMARY OF THE WORK SO FAR AND WHAT IS LEFT, AND TELL THE USER TO START A NEW "
+                         "CONVERSATION!!]\n", n_tokens, size, pct);
+}
