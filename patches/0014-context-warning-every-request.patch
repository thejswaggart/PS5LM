+// PS5LM: past LLAMA_HANDOFF_AT percent every chat request tells the model how
+// full its context is, whichever tools it has been calling. The web UI sends a
+// request for each tool round, so one long search session is covered too. The
+// count is the rendered prompt's, with the newest tool result in it. The text
+// goes on the last message, as templates refuse a system message anywhere but
+// first, and is not stored: the UI sends the conversation back without it.
+std::string ps5lm_context_warning(int n_tokens, bool saved);  // server-tools.cpp
+
+static json ps5lm_chat_params_parse(
+        const llama_vocab * vocab,
+        json & body,
+        const server_chat_params & opt,
+        std::vector<raw_buffer> & files,
+        common_chat_session & session) {
+    static const auto calls_save_handoff = [](const json & tool) {
+        return tool.is_object() && tool.contains("function") && tool.at("function").is_object()
+            && tool.at("function").value("name", std::string()) == "save_handoff";
+    };
+    const bool can_save = body.contains("tools") && body.at("tools").is_array()
+        && std::any_of(body.at("tools").begin(), body.at("tools").end(), calls_save_handoff);
+    if (!can_save || !body.contains("messages") || !body.at("messages").is_array() || body.at("messages").empty()) {
+        return oaicompat_chat_params_parse(vocab, body, opt, files, session);
+    }
+    json request = body;  // the parser may change what it is given
+    json parsed = oaicompat_chat_params_parse(vocab, body, opt, files, session);
+    if (!parsed.contains("prompt") || !parsed.at("prompt").is_string()) {
+        return parsed;
+    }
+    json & messages = request.at("messages");
+    bool saved = false;
+    for (const json & message : messages) {
+        if (message.is_object() && message.contains("tool_calls") && message.at("tool_calls").is_array()) {
+            saved = saved || std::any_of(message.at("tool_calls").begin(), message.at("tool_calls").end(), calls_save_handoff);
+        }
+    }
+    const int n_tokens = (int) common_tokenize(vocab, parsed.at("prompt").get<std::string>(), false, true).size();
+    const std::string warning = ps5lm_context_warning(n_tokens, saved);
+    json & last = messages.back();
+    const std::string role = last.is_object() ? last.value("role", std::string()) : std::string();
+    if (warning.empty() || (role != "user" && role != "tool") || !last.contains("content")) {
+        return parsed;
+    }
+    json & content = last.at("content");
+    if (content.is_string()) {
+        content = content.get<std::string>() + warning;
+    } else if (content.is_array()) {
+        content.push_back({{"type", "text"}, {"text", warning}});
+    } else {
+        return parsed;
+    }
+    SRV_INF("PS5LM: context warning added, prompt is %d tokens\n", n_tokens);
+    files.clear();
+    session = common_chat_session();
+    return oaicompat_chat_params_parse(vocab, request, opt, files, session);
+}
