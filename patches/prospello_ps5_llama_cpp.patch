index f4eaea5df..4ff51d1cc 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -2714,6 +2714,51 @@ static bool ggml_thread_apply_priority(int32_t prio) {
     return true;
 }
 
+#elif defined(__PROSPERO__)
+
+// PS5: Sony's thread calls stand in for the Linux ones. A payload may only run
+// on the CPUs in its affinity mask (0xea00 on firmware 13.60), shared with the
+// console's own services, so a mask outside it fails and priority is only ever
+// lowered. Sony priorities run 256 (first) to 767 (last); threads start at 700.
+int scePthreadSetaffinity(pthread_t thread, uint64_t mask);
+int scePthreadSetprio(pthread_t thread, int prio);
+
+static bool ggml_thread_apply_affinity(const bool * mask) {
+    uint64_t bits = 0;
+    for (int i = 0; i < 64 && i < GGML_MAX_N_THREADS; i++) {
+        if (mask[i]) {
+            bits |= 1ull << i;
+        }
+    }
+
+    const int err = scePthreadSetaffinity(pthread_self(), bits);
+    if (err != 0) {
+        fprintf(stderr, "warn: failed to set affinity mask 0x%llx : 0x%08x\n", (unsigned long long) bits, (unsigned) err);
+        return false;
+    }
+
+    return true;
+}
+
+static bool ggml_thread_apply_priority(int32_t prio) {
+    if (prio == GGML_SCHED_PRIO_NORMAL) {
+        return true;
+    }
+    if (prio != GGML_SCHED_PRIO_LOW) {
+        // Spinning workers above the system's own threads starve them.
+        fprintf(stderr, "warn: thread priority %d is not raised on the PS5\n", prio);
+        return false;
+    }
+
+    const int err = scePthreadSetprio(pthread_self(), 720);
+    if (err != 0) {
+        fprintf(stderr, "warn: failed to lower thread priority : 0x%08x\n", (unsigned) err);
+        return false;
+    }
+
+    return true;
+}
+
 #else // unsupported platforms
 
 static bool ggml_thread_apply_affinity(const bool * mask) {
