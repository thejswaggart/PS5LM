+// PS5LM: what ps5lm_chat_params_parse in server-context.cpp does with a chat
+// request whose prompt is n_tokens long: 0 nothing, 1 the model must call
+// save_handoff, 2 no tool calls as the conversation has saved its note. Both
+// only once save_handoff is due (LLAMA_HANDOFF_AT); the call is forced past
+// LLAMA_HANDOFF_FORCE_AT percent (default 85), or with under 4096 tokens left.
+int ps5lm_handoff_stage(int n_tokens, bool saved);
+int ps5lm_handoff_stage(int n_tokens, bool saved) {
+    const int size = ps5lm_ctx_size.load();
+    if (size <= 0) {
+        return 0;
+    }
+    const int pct = (int) ((int64_t) n_tokens * 100 / size);
+    if (pct < ps5lm_handoff_at()) {
+        return 0;
+    }
+    if (saved) {
+        return 2;
+    }
+    const char * at = std::getenv("LLAMA_HANDOFF_FORCE_AT");
+    int force_at = at && *at ? std::atoi(at) : 85;
+    if (force_at <= 0 || force_at > 100) {
+        force_at = 85;
+    }
+    return pct >= force_at || size - n_tokens < 4096 ? 1 : 0;
+}
